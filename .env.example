# ===== 抖音监控 本地配置模板 =====
# 用法：复制本文件为 .env，填入真实值后保存（.env 已被 .gitignore 排除，不会上传）
# 务必使用抖音【小号】的 Cookie，主号有风控连坐风险

# 抖音 Cookie：登录抖音网页版(https://www.douyin.com)后按 F12 -> Network(网络)
# -> 刷新页面 -> 点任一请求 -> Request Headers 里找到 "Cookie:" 整串复制（不要带 "Cookie:" 这几个字）
DOUYIN_COOKIE=

# 要监控的账号主页链接，多个用英文逗号分隔
# 形如：https://www.douyin.com/user/MS4wLjABAAAAxxxxxxxx
MONITOR_URLS=

# Server酱 SendKey（可选，用于推送到微信）：去 https://sct.ftqq.com 免费领取并扫码绑定
# 不填则只在本地控制台打印结果，不推送
SERVERCHAN_SENDKEY=
